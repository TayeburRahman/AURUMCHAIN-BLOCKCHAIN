# ===========================================
# ADMINISTRATIVE & PRIVATE KEYS
# ===========================================
# The private key of the wallet that deployed the programs (Super Admin)
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# REQUIRED INFRASTRUCTURE
# ===========================================
# Alchemcy/RPC Configuration
ALCHEMY_API_KEY=your_alchemy_key_here
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# WalletConnect Project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Backend & App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_KEY=your_api_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# BLOCKCHAIN CONFIGURATION (Solana)
# ===========================================
# Network Selection (devnet/mainnet-beta)
NEXT_PUBLIC_BLOCKCHAIN_NETWORK=solana-devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Solana Program IDs (Obtained from Solana Playground)
NEXT_PUBLIC_PROJECT_REGISTRY_PROGRAM_ID=your_registry_program_id
NEXT_PUBLIC_COMPLIANCE_PROGRAM_ID=your_compliance_program_id
NEXT_PUBLIC_ALLOCATION_DISTRIBUTION_PROGRAM_ID=your_distribution_program_id

# Administrative Wallet Addresses
NEXT_PUBLIC_ADMIN_WALLET=your_admin_wallet_public_key
NEXT_PUBLIC_TREASURY_WALLET=your_treasury_wallet_public_key

# Stablecoin Mint Addresses (Mock USDC for Devnet)
NEXT_PUBLIC_USDC_MINT=AJujcxZiQ1jUvSixiFLQNWFCpUtMuVsbyPCQ8ByU3jvf
NEXT_PUBLIC_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# Feature Flags
NEXT_PUBLIC_ENABLE_KYC=true
NEXT_PUBLIC_ENABLE_WALLET_CONNECTION=true
NEXT_PUBLIC_ENABLE_INVESTMENTS=true

# Sumsub KYC Configuration
SUMSUB_APP_TOKEN=your_sumsub_app_token_here
SUMSUB_SECRET_KEY=your_sumsub_secret_key_here
NEXT_PUBLIC_SUMSUB_LEVEL_NAME=basic-kyc-level

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Sentry Error Tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# NODE_ENV=development
# NEXT_PUBLIC_DEBUG=true
