# ===========================================
# GoldenFleece Frontend Environment Variables
# ===========================================

# ===========================================
# TEMPORARY (Supabase - Will be replaced)
# ===========================================
# These will be removed once backend API is integrated
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# WalletConnect Configuration
# Get your project ID from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Backend API Configuration (to be set when backend is ready)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_KEY=your_api_key_here

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================

# Network Selection
# Options: polygon-mumbai, polygon-mainnet, solana-devnet, solana-mainnet
NEXT_PUBLIC_BLOCKCHAIN_NETWORK=polygon-mumbai

# Chain ID (Polygon Mumbai = 80001, Polygon Mainnet = 137)
NEXT_PUBLIC_CHAIN_ID=80001

# Stablecoin Contract Addresses (Testnet)
# Replace with mainnet addresses for production
NEXT_PUBLIC_USDT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Treasury Wallet Address (Multi-sig recommended)
NEXT_PUBLIC_TREASURY_WALLET=0x0000000000000000000000000000000000000000

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# Feature Flags
NEXT_PUBLIC_ENABLE_KYC=true
NEXT_PUBLIC_ENABLE_WALLET_CONNECTION=true
NEXT_PUBLIC_ENABLE_INVESTMENTS=true

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Sentry Error Tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ===========================================
# DEVELOPMENT ONLY
# ===========================================

# Enable debug mode
# NODE_ENV=development

# Enable verbose logging
# NEXT_PUBLIC_DEBUG=true
