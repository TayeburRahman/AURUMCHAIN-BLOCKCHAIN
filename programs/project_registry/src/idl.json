{
  "version": "0.1.0",
  "name": "project_registry",
  "instructions": [
    {
      "name": "initializeControl",
      "accounts": [
        { "name": "control", "isMut": true, "isSigner": false },
        { "name": "payer", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "operationalAdmin", "type": "publicKey" },
        { "name": "operationalLimits", "type": "u64" }
      ]
    },
    {
      "name": "createProject",
      "accounts": [
        { "name": "control", "isMut": true, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "params", "type": { "defined": "CreateProjectParams" } }
      ]
    },
    {
      "name": "setProjectMint",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [{ "name": "mintKey", "type": "publicKey" }]
    },
    {
      "name": "revokeMintAuthority",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "mint", "isMut": true, "isSigner": false },
        { "name": "mintAuthorityPda", "isMut": false, "isSigner": false },
        { "name": "superAdmin", "isMut": false, "isSigner": true },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "updateProjectParams",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "params", "type": { "defined": "ProjectUpdateParams" } }
      ]
    },
    {
      "name": "updateProjectStatus",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "projectId", "type": "u64" },
        { "name": "newStatus", "type": { "defined": "ProjectStatus" } },
        { "name": "isPaused", "type": "bool" }
      ]
    },
    {
      "name": "recordTokensIssued",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "caller", "isMut": false, "isSigner": true }
      ],
      "args": [{ "name": "amount", "type": "u64" }]
    },
    {
      "name": "transferAuthority",
      "accounts": [
        { "name": "control", "isMut": true, "isSigner": false },
        { "name": "superAdmin", "isMut": false, "isSigner": true },
        { "name": "newAdmin", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "roleFlag", "type": "u8" },
        { "name": "newLimits", "type": { "option": "u64" } }
      ]
    },
    {
      "name": "setEmergencyPause",
      "accounts": [
        { "name": "control", "isMut": true, "isSigner": false },
        { "name": "superAdmin", "isMut": false, "isSigner": true }
      ],
      "args": [{ "name": "isPaused", "type": "bool" }]
    },
    {
      "name": "calibrateRegistry",
      "accounts": [
        { "name": "control", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [{ "name": "newCount", "type": "u64" }]
    },
    {
      "name": "issueTokens",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "mint", "isMut": true, "isSigner": false },
        { "name": "recipientTokenAccount", "isMut": true, "isSigner": false },
        { "name": "mintAuthorityPda", "isMut": false, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "amount", "type": "u64" }]
    },
    {
      "name": "resetRound",
      "accounts": [
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "project", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [{ "name": "newRoundLimit", "type": { "option": "u64" } }]
    }
  ],
  "accounts": [
    {
      "name": "ControlAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "superAdmin", "type": "publicKey" },
          { "name": "operationalAdmin", "type": "publicKey" },
          { "name": "upgradeAuthority", "type": "publicKey" },
          { "name": "isEmergencyPaused", "type": "bool" },
          { "name": "operationalLimits", "type": "u64" },
          { "name": "projectCount", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "ProjectAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "projectId", "type": "u64" },
          { "name": "registry", "type": "publicKey" },
          { "name": "creator", "type": "publicKey" },
          { "name": "name", "type": "string" },
          { "name": "symbol", "type": "string" },
          { "name": "uri", "type": "string" },
          { "name": "supplyCap", "type": "u64" },
          { "name": "tokensIssued", "type": "u64" },
          { "name": "minInvestmentUsdc", "type": "u64" },
          { "name": "maxInvestmentUsdc", "type": "u64" },
          { "name": "acceptedStablecoin", "type": "publicKey" },
          { "name": "treasuryWallet", "type": "publicKey" },
          { "name": "mint", "type": "publicKey" },
          { "name": "lockupEndTs", "type": "i64" },
          { "name": "subscriptionStart", "type": "i64" },
          { "name": "subscriptionEnd", "type": "i64" },
          { "name": "createdAt", "type": "i64" },
          { "name": "distributionCadence", "type": "u8" },
          { "name": "status", "type": { "defined": "ProjectStatus" } },
          { "name": "isPaused", "type": "bool" },
          { "name": "mintAuthorityRevoked", "type": "bool" },
          { "name": "roundLimitTokens", "type": "u64" },
          { "name": "currentRoundIssued", "type": "u64" },
          { "name": "assetType", "type": { "defined": "AssetType" } },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "CreateProjectParams",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "name", "type": "string" },
          { "name": "symbol", "type": "string" },
          { "name": "uri", "type": "string" },
          { "name": "supplyCap", "type": "u64" },
          { "name": "minInvestmentUsdc", "type": "u64" },
          { "name": "maxInvestmentUsdc", "type": "u64" },
          { "name": "acceptedStablecoin", "type": "publicKey" },
          { "name": "treasuryWallet", "type": "publicKey" },
          { "name": "lockupEndTs", "type": "i64" },
          { "name": "subscriptionStart", "type": "i64" },
          { "name": "subscriptionEnd", "type": "i64" },
          { "name": "distributionCadence", "type": "u8" },
          { "name": "assetType", "type": { "defined": "AssetType" } },
          { "name": "roundLimitTokens", "type": "u64" }
        ]
      }
    },
    {
      "name": "ProjectUpdateParams",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "minInvestmentUsdc", "type": { "option": "u64" } },
          { "name": "maxInvestmentUsdc", "type": { "option": "u64" } },
          { "name": "subscriptionStart", "type": { "option": "i64" } },
          { "name": "subscriptionEnd", "type": { "option": "i64" } },
          { "name": "distributionCadence", "type": { "option": "u8" } },
          { "name": "lockupEndTs", "type": { "option": "i64" } },
          { "name": "roundLimitTokens", "type": { "option": "u64" } },
          {
            "name": "assetType",
            "type": { "option": { "defined": "AssetType" } }
          }
        ]
      }
    },
    {
      "name": "ProjectStatus",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Draft" },
          { "name": "Funding" },
          { "name": "Active" },
          { "name": "Completed" },
          { "name": "Canceled" }
        ]
      }
    },
    {
      "name": "AssetType",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "RealEstate" },
          { "name": "Mining" },
          { "name": "Other" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "ProjectCreated",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "name", "type": "string", "index": false },
        { "name": "supplyCap", "type": "u64", "index": false },
        { "name": "treasuryWallet", "type": "publicKey", "index": false }
      ]
    },
    {
      "name": "ControlInitialized",
      "fields": [
        { "name": "superAdmin", "type": "publicKey", "index": false },
        { "name": "operationalAdmin", "type": "publicKey", "index": false }
      ]
    },
    {
      "name": "TokensMinted",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "recipient", "type": "publicKey", "index": false },
        { "name": "amount", "type": "u64", "index": false },
        { "name": "totalIssued", "type": "u64", "index": false },
        { "name": "roundIssued", "type": "u64", "index": false }
      ]
    },
    {
      "name": "TokensIssued",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "amountIssued", "type": "u64", "index": false },
        { "name": "totalIssued", "type": "u64", "index": false },
        { "name": "supplyCap", "type": "u64", "index": false }
      ]
    },
    {
      "name": "RoundReset",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "oldRoundIssued", "type": "u64", "index": false },
        { "name": "oldRoundLimit", "type": "u64", "index": false },
        { "name": "newRoundLimit", "type": "u64", "index": false }
      ]
    },
    {
      "name": "MintAuthorityRevoked",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "mint", "type": "publicKey", "index": false }
      ]
    },
    {
      "name": "EmergencyPauseToggled",
      "fields": [
        { "name": "isPaused", "type": "bool", "index": false },
        { "name": "authority", "type": "publicKey", "index": false }
      ]
    },
    {
      "name": "MintRegistered",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "mint", "type": "publicKey", "index": false }
      ]
    },
    {
      "name": "AuthorityUpdated",
      "fields": [
        { "name": "role", "type": "u8", "index": false },
        { "name": "newValue", "type": "publicKey", "index": false }
      ]
    },
    {
      "name": "ProjectUpdated",
      "fields": [{ "name": "projectId", "type": "u64", "index": false }]
    },
    {
      "name": "ProjectStateChanged",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        {
          "name": "oldStatus",
          "type": { "defined": "ProjectStatus" },
          "index": false
        },
        {
          "name": "newStatus",
          "type": { "defined": "ProjectStatus" },
          "index": false
        },
        { "name": "oldIsPaused", "type": "bool", "index": false },
        { "name": "newIsPaused", "type": "bool", "index": false }
      ]
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "Unauthorized",
      "msg": "Caller is not authorized to perform this action"
    },
    {
      "code": 6001,
      "name": "StringTooLong",
      "msg": "String field exceeds the maximum allowed byte length"
    },
    {
      "code": 6002,
      "name": "UnauthorizedCpiCaller",
      "msg": "CPI caller is not an authorized program or signer"
    },
    {
      "code": 6003,
      "name": "InvalidThresholds",
      "msg": "min_investment must be <= max_investment"
    },
    {
      "code": 6004,
      "name": "ZeroSupplyCap",
      "msg": "Supply cap must be greater than zero"
    },
    {
      "code": 6005,
      "name": "InvalidSubscriptionWindow",
      "msg": "subscription_end must be after subscription_start"
    },
    { "code": 6006, "name": "Overflow", "msg": "Arithmetic overflow" },
    {
      "code": 6007,
      "name": "MintAlreadySet",
      "msg": "Mint address is already set for this project"
    },
    {
      "code": 6008,
      "name": "InvalidMint",
      "msg": "Provided mint key is invalid (default pubkey)"
    },
    {
      "code": 6009,
      "name": "MintAuthorityAlreadyRevoked",
      "msg": "Mint authority has already been revoked"
    },
    {
      "code": 6010,
      "name": "SupplyCapExceeded",
      "msg": "Token issuance would exceed the project supply cap"
    },
    {
      "code": 6011,
      "name": "ExceedsOperationalLimit",
      "msg": "Action exceeds the allowed operational limits"
    },
    {
      "code": 6012,
      "name": "InvalidStatusTransition",
      "msg": "Cannot transition from a terminal state (Completed / Canceled)"
    },
    {
      "code": 6013,
      "name": "MintNotSet",
      "msg": "Mint address must be set before moving to Funding status"
    },
    {
      "code": 6014,
      "name": "RoundLimitExceeded",
      "msg": "Token issuance would exceed the current round limit"
    }
  ]
}
