{
  "version": "0.1.0",
  "name": "allocation_distribution",
  "instructions": [
    {
      "name": "initializeConfig",
      "accounts": [
        { "name": "control", "isMut": true, "isSigner": false },
        { "name": "payer", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "admin", "type": "publicKey" }]
    },
    {
      "name": "createEpoch",
      "accounts": [
        { "name": "counter", "isMut": true, "isSigner": false },
        { "name": "epoch", "isMut": true, "isSigner": false },
        { "name": "projectAccount", "isMut": false, "isSigner": false },
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true },
        { "name": "payer", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "projectId", "type": "u64" },
        { "name": "profitPerToken", "type": "u64" }
      ]
    },
    {
      "name": "executePayout",
      "accounts": [
        { "name": "epoch", "isMut": true, "isSigner": false },
        { "name": "payoutRecord", "isMut": true, "isSigner": false },
        { "name": "projectAccount", "isMut": false, "isSigner": false },
        { "name": "investorTokenAccount", "isMut": false, "isSigner": false },
        { "name": "investorPaymentAccount", "isMut": true, "isSigner": false },
        { "name": "treasuryVault", "isMut": true, "isSigner": false },
        { "name": "control", "isMut": false, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true },
        { "name": "investor", "isMut": false, "isSigner": false },
        { "name": "payer", "isMut": true, "isSigner": true },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "DistributionControl",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "admin", "type": "publicKey" },
          { "name": "isPaused", "type": "bool" },
          { "name": "bump", "type": "u8" },
          { "name": "padding", "type": { "array": ["u8", 64] } }
        ]
      }
    },
    {
      "name": "DistributionEpoch",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "projectId", "type": "u64" },
          { "name": "epochId", "type": "u64" },
          { "name": "profitPerToken", "type": "u64" },
          { "name": "recordDate", "type": "i64" },
          { "name": "totalPayoutsExecuted", "type": "u64" },
          { "name": "isCompleted", "type": "bool" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "EpochCounter",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "projectId", "type": "u64" },
          { "name": "count", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "ShadowProjectAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "projectId", "type": "u64" },
          { "name": "registry", "type": "publicKey" },
          { "name": "creator", "type": "publicKey" },
          { "name": "name", "type": "string" },
          { "name": "symbol", "type": "string" },
          { "name": "uri", "type": "string" },
          { "name": "supplyCap", "type": "u64" },
          { "name": "tokensIssued", "type": "u64" },
          { "name": "minInvestmentUsdc", "type": "u64" },
          { "name": "maxInvestmentUsdc", "type": "u64" },
          { "name": "tokenPriceUsdc", "type": "u64" },
          { "name": "acceptedStablecoin", "type": "publicKey" },
          { "name": "treasuryWallet", "type": "publicKey" },
          { "name": "mint", "type": "publicKey" },
          { "name": "lockupEndTs", "type": "i64" },
          { "name": "subscriptionStart", "type": "i64" },
          { "name": "subscriptionEnd", "type": "i64" },
          { "name": "createdAt", "type": "i64" },
          { "name": "distributionCadence", "type": "u8" },
          { "name": "durationMonths", "type": "u8" },
          { "name": "distributionMode", "type": "u8" },
          { "name": "status", "type": { "defined": "ExternalProjectStatus" } },
          { "name": "isPaused", "type": "bool" },
          { "name": "mintAuthorityRevoked", "type": "bool" },
          { "name": "roundLimitTokens", "type": "u64" },
          { "name": "currentRoundIssued", "type": "u64" },
          { "name": "assetType", "type": { "defined": "ExternalAssetType" } },
          { "name": "bump", "type": "u8" },
          { "name": "padding", "type": { "array": ["u8", 42] } }
        ]
      }
    },
    {
      "name": "PayoutRecord",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "epoch", "type": "publicKey" },
          { "name": "investor", "type": "publicKey" },
          { "name": "amountPaid", "type": "u64" },
          { "name": "timestamp", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "ExternalProjectStatus",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Draft" },
          { "name": "Funding" },
          { "name": "Funded" },
          { "name": "Active" },
          { "name": "Completed" },
          { "name": "Canceled" }
        ]
      }
    },
    {
      "name": "ExternalAssetType",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "RealEstate" },
          { "name": "Mining" },
          { "name": "Other" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "EpochCreated",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "epochId", "type": "u64", "index": false },
        { "name": "profitPerToken", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    },
    {
      "name": "PayoutExecuted",
      "fields": [
        { "name": "projectId", "type": "u64", "index": false },
        { "name": "epochId", "type": "u64", "index": false },
        { "name": "investor", "type": "publicKey", "index": false },
        { "name": "amount", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    }
  ],
  "errors": [
    { "code": 6000, "name": "Unauthorized", "msg": "Unauthorized access" },
    {
      "code": 6001,
      "name": "ProgramPaused",
      "msg": "Program is currently paused"
    },
    {
      "code": 6002,
      "name": "EpochCompleted",
      "msg": "Epoch is already completed"
    },
    {
      "code": 6003,
      "name": "AlreadyClaimed",
      "msg": "Payout already claimed for this epoch"
    },
    { "code": 6004, "name": "Overflow", "msg": "Arithmetic overflow" },
    {
      "code": 6005,
      "name": "InvalidTokenAccount",
      "msg": "Invalid token account"
    },
    {
      "code": 6006,
      "name": "InsufficientBalance",
      "msg": "Insufficient balance for payout"
    },
    {
      "code": 6007,
      "name": "InvalidTreasury",
      "msg": "Invalid treasury wallet"
    }
  ]
}
